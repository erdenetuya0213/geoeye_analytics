{
  "name": "@geoeye/analytics-desktop",
  "version": "0.1.0",
  "description": "Windows local-first geological analytics workspace",
  "author": "GeoEye",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "desktop": "pnpm build && electron .",
    "dist:windows": "pnpm build && electron-builder --win nsis",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/activation.node.cjs tests/activation-ipc.node.cjs tests/database-connection.node.cjs tests/workspace-files.node.cjs && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@geoeye/datapool-client": "workspace:*",
    "@tanstack/react-query": "^5.90.2",
    "echarts": "6.0.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "com.geoeye.analytics",
    "productName": "GeoEye Analytics",
    "electronDist": "node_modules/electron/dist",
    "afterPack": "electron/after-pack.cjs",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    }
  }
}
