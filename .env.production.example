# GeoEye Data Pool - production RUNTIME settings.
# Copy to .env.production (git-ignored) on the production host. This file is loaded into
# the API container, so it must hold runtime settings only. Release-only credentials
# (the postgres connection and the role password) belong in .env.release.
# Never expose any of these as VITE_* variables.

NODE_ENV=production

# Public host name of the Analytics site. Caddy obtains its TLS certificate automatically,
# so DNS for this name must already point at the host and ports 80/443 must be open.
GEOEYE_SITE_ADDRESS=analytics.example.com

# Runtime connection as the least-privilege geoeye_api role (never postgres).
# Supabase dashboard > Connect. Session pooler username is geoeye_api.PROJECT_REF;
# direct-connection username is geoeye_api. Percent-encode reserved password characters.
DATABASE_URL=postgresql://geoeye_api.PROJECT_REF:URL_ENCODED_APP_PASSWORD@POOLER_HOST:5432/postgres

DATABASE_SSL=require
# For full certificate verification: DATABASE_SSL=verify-full and paste the PEM below.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000

# Signs the session tokens issued when users sign in with their GeoEye account (the same
# accounts as GeoEye Field). At least 32 random characters. Changing it signs everyone out.
DATAPOOL_SESSION_SECRET=
# How long a sign-in lasts, in seconds (default 12 hours).
DATAPOOL_SESSION_TTL_SECONDS=43200

# Optional service token for release tooling and the smoke test. Users never need it.
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Use a different token from staging.
DATAPOOL_BEARER_TOKEN=

# Leave blank: the UI reaches the API through the same origin (/api).
DATAPOOL_CORS_ORIGINS=

# Keeps the analytical read model current with Field. Safe on every API instance.
PROJECTION_INTERVAL_SECONDS=300
PROJECTION_INCLUDE_UNACCEPTED=false

# production:smoke target, e.g. https://analytics.example.com/api
SMOKE_ENDPOINT=
