# GeoEye Analytics edge: static UI + same-origin proxy to the Data Pool API.
#
# GEOEYE_SITE_ADDRESS  public host name, e.g. analytics.example.com. Caddy obtains and
#                      renews a TLS certificate for it automatically. Use ":80" behind
#                      a load balancer that already terminates TLS.
# DATAPOOL_UPSTREAM    host:port of the Data Pool API (default api:8080).

{$GEOEYE_SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# The UI is fully self-hosted: no third-party scripts, styles, fonts, or API calls.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}

	# /api/v1/... -> http://api:8080/v1/...
	handle_path /api/* {
		reverse_proxy {$DATAPOOL_UPSTREAM:api:8080} {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		root * /srv

		# Hashed build output never changes; the HTML shell must always be revalidated.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
