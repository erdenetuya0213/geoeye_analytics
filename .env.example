DATABASE_URL=postgres://geoeye:geoeye@127.0.0.1:54329/geoeye
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
HOST=127.0.0.1
PORT=8080
# Set in shared environments. If both are omitted, the local API runs without authentication.
# DATAPOOL_SESSION_SECRET enables sign-in with GeoEye accounts; DATAPOOL_BEARER_TOKEN is a service token.
DATAPOOL_SESSION_SECRET=
DATAPOOL_BEARER_TOKEN=
# Comma-separated exact browser origins. Leave blank when UI and API share an origin.
DATAPOOL_CORS_ORIGINS=
# Seconds between automatic Field -> Data Pool projection runs inside the API. 0 disables it;
# run `pnpm db:project` or POST /v1/projects/{id}/projection instead.
PROJECTION_INTERVAL_SECONDS=0
# true also projects draft and flagged Field rows, tagged with their quality.
PROJECTION_INCLUDE_UNACCEPTED=false
