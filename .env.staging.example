# GeoEye Data Pool - staging on Supabase.
# Copy to .env.staging (git-ignored) and fill in. Used by the `pnpm staging:*` commands.
# Never expose any of these as VITE_* variables.

NODE_ENV=production

# Supabase dashboard > Connect. Copy the strings; do not build host names by hand.
# Percent-encode reserved characters in passwords.
#
# Release connection (postgres role): used by staging:preflight, staging:migrate and
# staging:provision-role. Prefer the direct connection; use the Session pooler (port 5432)
# from an IPv4-only network. Do not use the transaction pooler (port 6543) here.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres

# Runtime connection (geoeye_api role): used by staging:api and staging:project.
# Pooler username is geoeye_api.PROJECT_REF; direct username is geoeye_api.
DATABASE_URL=postgresql://geoeye_api.PROJECT_REF:URL_ENCODED_APP_PASSWORD@POOLER_HOST:5432/postgres

# Password given to geoeye_api by staging:provision-role. At least 32 characters.
# Remove this line after provisioning.
DATABASE_APP_PASSWORD=

DATABASE_SSL=require
# For full certificate verification: DATABASE_SSL=verify-full and paste the PEM below.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DATABASE_POOL_MAX=5

HOST=127.0.0.1
PORT=8080
# Signs the session tokens issued when users sign in with their GeoEye account (the same
# accounts as GeoEye Field). At least 32 random characters. Changing it signs everyone out.
DATAPOOL_SESSION_SECRET=
# How long a sign-in lasts, in seconds (default 12 hours).
DATAPOOL_SESSION_TTL_SECONDS=43200

# Optional service token for release tooling and the smoke test. Users never need it.
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
DATAPOOL_BEARER_TOKEN=
# Exact HTTPS origins of the Analytics UI when it is served from another origin.
# Leave blank when the UI reaches the API through the Vite /api proxy or a same-origin proxy.
DATAPOOL_CORS_ORIGINS=

PROJECTION_INTERVAL_SECONDS=300
PROJECTION_INCLUDE_UNACCEPTED=false

# staging:smoke target. Defaults to http://127.0.0.1:$PORT when blank.
SMOKE_ENDPOINT=
