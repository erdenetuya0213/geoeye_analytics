# GeoEye Data Pool - production RELEASE credentials.
# Copy to .env.release (git-ignored) on the machine that runs `pnpm production:preflight`,
# `production:migrate` and `production:provision-role`. Keep it off the production host:
# these credentials can change the schema and are never needed at runtime.

# postgres role. Prefer the direct connection; use the Session pooler (port 5432) from an
# IPv4-only network. Do not use the transaction pooler (port 6543).
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres

# Password given to geoeye_api by production:provision-role. At least 32 characters, and
# the same value that DATABASE_URL in .env.production uses. Clear it after provisioning.
DATABASE_APP_PASSWORD=
